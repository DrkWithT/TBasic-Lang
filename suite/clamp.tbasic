`test native clamp procedure`

LET low : 10.0, high : 20.0;

LET x : clampf(9.75, 10.0, 20.0);
LET y : clampf(20.5, low, high);
LET z : clampf(19.5, low, high);

ASSERT x == 10.0, "Expected clampf 1 as 10.0";
ASSERT y == 20.0, "Expected clampf 2 as 20.0";
ASSERT z == 19.5, "Expected clampf 2 as 19.5";

RET TRUE;
