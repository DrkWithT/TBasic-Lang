`test breaks in loops`

FUN testA(x):
    LET i : 0;
    
    WHILE i < x:
        IF i == (x / 2):
            BREAK;
        END ELSE:
            i := i + 1;
        END
    END

    RET i;
END

FUN testB(y):
    LET j : y, old : 0;

    WHILE j > 0:
        IF j == y / 2:
            old := j;
            j := j / 2;
            CONTINUE;
        END ELSE:
            j := j - 1;
        END
    END

    RET j + old;
END

ASSERT testA(10) == 5, "Expected testA(10) as 5";
ASSERT testB(10) == 5, "Expected testB(10) as 5";

RET TRUE;
